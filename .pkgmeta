package-as: GamepadGrimoire

enable-nolib-creation: no

ignore:
  - "*_spec.lua"
  - spec
  - tools
  - docs
  - node_modules
  - package.json
  - package-lock.json
  - lefthook.yml
  - commitlint.config.mjs
  - stylua.toml
  - .busted
  - .luacheckrc
  - .luarc.json
  - .editorconfig
  - CONTRIBUTING.md
  - AGENTS.md
  - CLAUDE.md
  - SECURITY.md
  - pyproject.toml
  - .luacov
  - .github

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
